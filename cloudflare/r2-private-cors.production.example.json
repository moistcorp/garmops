{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://www.garmops.com"
        ],
        "methods": [
          "PUT",
          "HEAD"
        ],
        "headers": [
          "content-type",
          "x-amz-checksum-sha256",
          "x-amz-meta-file-id",
          "x-amz-meta-expected-size",
          "x-amz-meta-expected-sha256"
        ]
      },
      "exposeHeaders": [
        "etag",
        "x-amz-checksum-sha256"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
