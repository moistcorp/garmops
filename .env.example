# Public application configuration
APP_SURFACE=customer
NEXT_PUBLIC_APP_SURFACE=customer
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000
NEXT_PUBLIC_STAFF_APP_URL=http://localhost:3001
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_API_KEY=replace-with-medusa-publishable-key
# Docker deployments may mount the generated key instead of copying it here.
MEDUSA_PUBLISHABLE_API_KEY_FILE=
APP_TIMEZONE=Asia/Kolkata
APP_ENV=development

# Feature rollout
NEXT_PUBLIC_ACCOUNTS_ENABLED=true
NEXT_PUBLIC_CLOUD_DESIGNS_ENABLED=true
STAFF_PORTAL_ENABLED=false
CLOUD_DESIGNS_ENABLED=true
CONFIGURATOR_CHECKOUT_ENABLED=true
SAMPLE_CHECKOUT_ENABLED=true
ENABLE_REALTIME_ORDER_UPDATES=false
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ABANDONED_DESIGN_EMAILS_ENABLED=false

# Optional browser-safe integrations
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=false

# Server-only operational configuration belongs in Medusa, not the frontend.
