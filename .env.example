# Required for real PayU payments. Keep the salt server-side.
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt

# Recommended for signing short-lived payment-result cookies.
# Falls back to PAYU_SALT when omitted.
PAYMENT_SIGNING_SECRET=use_a_long_random_secret

# Use PayU's test endpoint while validating sandbox credentials.
NEXT_PUBLIC_PAYU_BASE_URL=https://test.payu.in/_payment

# Required for confirmation, sample-order, and contact emails.
RESEND_API_KEY=your_resend_api_key

# Must use a sender/domain verified in Resend.
RESEND_FROM_EMAIL="Garmops <orders@garmops.com>"

# Receives new contact enquiries and paid sample-order notifications.
CONTACT_TO_EMAIL=hello@garmops.com

# Optional. Defaults to the current Garmops Formspree form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mnqvkwqj

# Optional fallback to DNS verification. Paste the raw token or complete HTML tag.
GOOGLE_SITE_VERIFICATION=your_google_verification_token
