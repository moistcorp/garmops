# Application
APP_SURFACE=customer
NEXT_PUBLIC_APP_SURFACE=customer
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000
NEXT_PUBLIC_STAFF_APP_URL=http://localhost:3001
APP_TIMEZONE=Asia/Kolkata
APP_ENV=development

# Supabase public/SSR
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
AUTH_RATE_LIMIT_SALT=

# Cloudflare R2 server only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_PUBLIC_BUCKET=garmops-public-downloads
R2_PRIVATE_BUCKET=garmops-private-orders

# Public R2/download origin
NEXT_PUBLIC_DOWNLOADS_BASE_URL=https://downloads.garmops.com

# Required for real PayU payments. Keep the salt server-side.
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt

# Recommended for signing short-lived payment-result cookies.
# Falls back to PAYU_SALT when omitted.
PAYMENT_SIGNING_SECRET=use_a_long_random_secret

# PayU server-only verification configuration
PAYU_VERIFY_BASE_URL=
PAYU_ENVIRONMENT=test

# Use PayU's test endpoint while validating sandbox credentials.
NEXT_PUBLIC_PAYU_BASE_URL=https://test.payu.in/_payment

# Invoice legal/tax configuration.
INVOICE_SELLER_LEGAL_NAME="M/s Moist Corp"
INVOICE_SELLER_ADDRESS="2nd Floor, Q-5 Site-5, Road Number 4, Prime Infra Engineers, UPSIDC Site 5, Greater Noida, Gautambuddha Nagar, Uttar Pradesh 201312"
INVOICE_SELLER_GSTIN=09HPFPS8162L1ZY
INVOICE_SELLER_STATE="Uttar Pradesh"
# Required only for a future catalogue item without a configured mapping.
INVOICE_DEFAULT_HSN_CODE=CONFIGURE_HSN_CODE
INVOICE_GST_RATE_BASIS_POINTS=500

ESTIMATE_VALIDITY_DAYS=7

# Required for confirmation, sample-order, and contact emails.
RESEND_API_KEY=your_resend_api_key

# Must use a sender/domain verified in Resend.
RESEND_FROM_EMAIL="Garmops <orders@garmops.com>"

# Receives new contact enquiries and paid sample-order notifications.
CONTACT_TO_EMAIL=hello@garmops.com
OPERATIONS_ALERT_EMAIL=
FINANCE_ALERT_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Internal scheduled jobs
CRON_SECRET=
JOB_WORKER_ID=garmops-vercel

# Feature rollout. Every backend integration is disabled by default.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_CLOUD_DESIGNS_ENABLED=false
STAFF_PORTAL_ENABLED=false
R2_PRIVATE_UPLOADS_ENABLED=false
CLOUD_DESIGNS_ENABLED=false
CONFIGURATOR_CHECKOUT_ENABLED=false
SAMPLE_CHECKOUT_ENABLED=false
ENABLE_REALTIME_ORDER_UPDATES=false
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ABANDONED_DESIGN_EMAILS_ENABLED=false

# Optional privacy-first product analytics (EU host recommended). Session replay is disabled in code.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional privacy-safe error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENABLED=false

# Optional private malware scanner. Deploy ops/malware-scanner separately.
MALWARE_SCANNING_ENABLED=false
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCAN_TIMEOUT_MS=15000

# Lean job execution
JOB_PROCESSING_BACKEND=postgres
JOB_INLINE_MAX_COUNT=1
JOB_BATCH_SIZE=20

# Optional fallback to DNS verification. Paste the raw token or complete HTML tag.
GOOGLE_SITE_VERIFICATION=your_google_verification_token
